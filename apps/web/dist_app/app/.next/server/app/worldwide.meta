{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/worldwide/layout,_N_T_/worldwide/page,_N_T_/worldwide"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/worldwide/__PAGE__",
    "/worldwide",
    "/_index",
    "/_head"
  ]
}