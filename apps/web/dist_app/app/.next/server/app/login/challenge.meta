{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/login/layout,_N_T_/login/challenge/layout,_N_T_/login/challenge/page,_N_T_/login/challenge"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/login/challenge/__PAGE__",
    "/login/challenge",
    "/login",
    "/_index",
    "/_head"
  ]
}